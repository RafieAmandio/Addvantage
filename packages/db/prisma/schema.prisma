generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profile {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  handle            String?          @unique
  email             String           @unique
  passwordHash      String?          @map("password_hash")
  emailVerified     Boolean          @default(false) @map("email_verified")
  tier              String           @default("free")
  isAdmin           Boolean          @default(false) @map("is_admin")
  allowMention      Boolean          @default(true) @map("allow_mention")
  signedLiability   Boolean          @default(false) @map("signed_liability")
  joinedAt          DateTime         @default(now()) @map("joined_at") @db.Timestamptz(6)
  renewsAt          DateTime?        @map("renews_at") @db.Timestamptz(6)
  package           String?
  tradingLength     String?          @map("trading_length")
  longestProfitable String?          @map("longest_profitable")
  markets           String[]         @default([])
  yearlyGoal        String?          @map("yearly_goal")
  faultAttribution  String?          @map("fault_attribution")
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  consultMessages   ConsultMessage[]
  consultSessions   ConsultSession[]
  emailLogs         EmailLog[]
  reviewedNews      NewsItem[]       @relation("NewsReviewer")
  payments          Payment[]
  telegramAdmins    TelegramAdmin[]
  timelineEvents    TimelineEvent[]  @relation("TimelineCreator")
  tradingPlans      TradingPlan[]

  @@map("profiles")
}

model Source {
  code          String         @id
  name          String
  url           String
  adapter       String
  enabled       Boolean        @default(true)
  pollMinutes   Int            @default(60) @map("poll_minutes")
  lastPolledAt  DateTime?      @map("last_polled_at") @db.Timestamptz(6)
  lastSuccessAt DateTime?      @map("last_success_at") @db.Timestamptz(6)
  lastError     String?        @map("last_error")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  ingestionRuns IngestionRun[]
  newsItems     NewsItem[]

  @@map("sources")
}

model NewsItem {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceCode     String          @map("source_code")
  sourceUrl      String?         @map("source_url")
  contentHash    String          @map("content_hash")
  fetchedAt      DateTime        @default(now()) @map("fetched_at") @db.Timestamptz(6)
  rawText        String?         @map("raw_text")
  headline       String
  rephrased      String?
  analysis       String
  impact         String
  bias           String
  affects        String[]        @default([])
  tags           String[]        @default([])
  relatedPlanIds String[]        @default([]) @map("related_plan_ids")
  author         String
  status         String          @default("pending")
  reviewedBy     String?         @map("reviewed_by") @db.Uuid
  reviewedAt     DateTime?       @map("reviewed_at") @db.Timestamptz(6)
  publishedAt    DateTime?       @map("published_at") @db.Timestamptz(6)
  aiSystemPrompt String?         @map("ai_system_prompt")
  aiUserMessage  String?         @map("ai_user_message")
  aiRawResponse  String?         @map("ai_raw_response")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  reviewer       Profile?        @relation("NewsReviewer", fields: [reviewedBy], references: [id], onUpdate: NoAction)
  source         Source          @relation(fields: [sourceCode], references: [code], onDelete: NoAction)
  timelineEvents TimelineEvent[]

  @@unique([sourceCode, contentHash])
  @@index([status])
  @@index([publishedAt(sort: Desc)])
  @@index([sourceCode])
  @@index([affects], map: "news_items_affects_gin", type: Gin)
  @@index([tags], map: "news_items_tags_gin", type: Gin)
  @@map("news_items")
}

model TelegramAdmin {
  tgUserId  BigInt   @id @map("tg_user_id")
  profileId String?  @map("profile_id") @db.Uuid
  label     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  profile   Profile? @relation(fields: [profileId], references: [id], onUpdate: NoAction)

  @@map("telegram_admins")
}

model IngestionRun {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceCode     String    @map("source_code")
  startedAt      DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt     DateTime? @map("finished_at") @db.Timestamptz(6)
  status         String    @default("running")
  itemsFetched   Int       @default(0) @map("items_fetched")
  itemsNew       Int       @default(0) @map("items_new")
  itemsRephrased Int       @default(0) @map("items_rephrased")
  error          String?
  source         Source    @relation(fields: [sourceCode], references: [code], onDelete: NoAction)

  @@index([sourceCode, startedAt(sort: Desc)], map: "ingestion_runs_source_idx")
  @@index([startedAt(sort: Desc)], map: "ingestion_runs_started_idx")
  @@map("ingestion_runs")
}

model InstrumentBar {
  symbol   String
  interval String
  ts       DateTime @db.Timestamptz(6)
  open     Decimal? @db.Decimal
  high     Decimal? @db.Decimal
  low      Decimal? @db.Decimal
  close    Decimal? @db.Decimal
  volume   Decimal? @db.Decimal

  @@id([symbol, interval, ts])
  @@map("instrument_bars")
}

model TimelineEvent {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind       String
  sourceCode String?   @map("source_code")
  occurredAt DateTime  @map("occurred_at") @db.Timestamptz(6)
  symbols    String[]  @default([])
  title      String
  body       String?
  url        String?
  bias       String?
  impact     String?
  metadata   Json?
  newsItemId String?   @map("news_item_id") @db.Uuid
  createdBy  String?   @map("created_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  creator    Profile?  @relation("TimelineCreator", fields: [createdBy], references: [id], onUpdate: NoAction)
  newsItem   NewsItem? @relation(fields: [newsItemId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([newsItemId], map: "timeline_events_news_item_idx")
  @@index([occurredAt(sort: Desc)], map: "timeline_events_occurred_idx")
  @@index([symbols], map: "timeline_events_symbols_gin", type: Gin)
  @@map("timeline_events")
}

model TradingPlan {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  symbol      String
  thesis      String
  direction   String
  bias        String    @default("neutral")
  entry       Decimal?  @db.Decimal
  stop        Decimal?  @db.Decimal
  target      Decimal?  @db.Decimal
  rMultiple   Decimal?  @map("r_multiple") @db.Decimal
  setups      Json      @default("[]")
  tags        String[]  @default([])
  risks       String[]  @default([])
  tier        String    @default("free")
  status      String    @default("draft")
  outcome     String?
  authorId    String?   @map("author_id") @db.Uuid
  closePrice  Decimal?  @map("close_price") @db.Decimal
  realizedR   Decimal?  @map("realized_r") @db.Decimal
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)
  closedAt    DateTime? @map("closed_at") @db.Timestamptz(6)
  imageUrl    String?   @map("image_url")
  imageKey    String?   @map("image_key")
  author      Profile?  @relation(fields: [authorId], references: [id], onUpdate: NoAction)

  @@index([symbol])
  @@index([authorId], map: "trading_plans_author_idx")
  @@index([publishedAt(sort: Desc)], map: "trading_plans_published_idx")
  @@index([tags], map: "trading_plans_tags_gin", type: Gin)
  @@map("trading_plans")
}

model ConsultSession {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String           @map("user_id") @db.Uuid
  title       String           @default("New session")
  status      String           @default("open")
  unreadAdmin Boolean          @default(true) @map("unread_admin")
  unreadUser  Boolean          @default(false) @map("unread_user")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  messages    ConsultMessage[]
  user        Profile          @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId, updatedAt(sort: Desc)], map: "consult_sessions_user_idx")
  @@index([status, updatedAt(sort: Desc)], map: "consult_sessions_status_idx")
  @@map("consult_sessions")
}

model ConsultMessage {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId String         @map("session_id") @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  role      String
  content   String
  metadata  Json?
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  session   ConsultSession @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user      Profile        @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([sessionId, createdAt], map: "consult_messages_session_idx")
  @@index([userId], map: "consult_messages_user_idx")
  @@map("consult_messages")
}

model EducationPrimer {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug       String   @unique
  title      String
  author     String   @default("Anthony")
  framework  String?
  summary    String?
  body       String[] @default([])
  tags       String[] @default([])
  readingMin Int      @default(3) @map("reading_min")
  locked     Boolean  @default(false)
  published  Boolean  @default(true)
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([published, sortOrder], map: "education_primers_pub_idx")
  @@index([tags], map: "education_primers_tags_gin", type: Gin)
  @@map("education_primers")
}

model VideoModule {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug        String   @unique
  title       String
  description String   @default("")
  category    String   @default("analysis")
  provider    String   @default("youtube")
  videoId     String   @map("video_id")
  duration    String   @default("")
  sortOrder   Int      @default(0) @map("sort_order")
  published   Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([published, sortOrder], map: "video_modules_published_sort_idx")
  @@map("video_modules")
}

model ShortLink {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug      String   @unique
  targetUrl String   @map("target_url")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("short_links")
}

model Payment {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId   String    @map("profile_id") @db.Uuid
  externalId  String?   @map("external_id")
  externalRef String    @unique @map("external_ref")
  provider    String
  amount      Decimal   @db.Decimal
  currency    String    @default("IDR")
  status      String    @default("pending")
  tier        String
  invoiceUrl  String?   @map("invoice_url")
  description String?
  paidAt      DateTime? @map("paid_at") @db.Timestamptz(6)
  expiredAt   DateTime? @map("expired_at") @db.Timestamptz(6)
  metadata    Json?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  profile     Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([status])
  @@index([externalId])
  @@index([profileId, createdAt(sort: Desc)], map: "payments_profile_idx")
  @@map("payments")
}

/// Early-access / cashback intake. Standalone application (no account yet):
/// the team verifies payment + affiliate manually and grants access out of band.
/// Backend-only table — RLS enabled with NO policy; reached solely via the
/// service-role API connection (same posture as payments/profiles).
model EarlyAccessApplication {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                   String    @unique
  telegramHandle          String    @map("telegram_handle")
  wantsCashback           Boolean?  @map("wants_cashback")
  broker                  String?
  brokerAccountRef        String?   @map("broker_account_ref")
  signedName              String?   @map("signed_name")
  signedAt                DateTime? @map("signed_at") @db.Timestamptz(6)
  acknowledgements        Json?
  paymentMethod           String?   @map("payment_method")
  paymentAmount           Decimal?  @map("payment_amount") @db.Decimal
  paymentCurrency         String?   @map("payment_currency")
  proofImageUrl           String?   @map("proof_image_url")
  status                  String    @default("draft")
  confirmationEmailSentAt DateTime? @map("confirmation_email_sent_at") @db.Timestamptz(6)
  provisionedAt           DateTime? @map("provisioned_at") @db.Timestamptz(6)
  accountId               String?   @map("account_id") @db.Uuid
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([createdAt(sort: Desc)])
  @@map("early_access_applications")
}

model EmailLog {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId         String?   @map("profile_id") @db.Uuid
  kind              String
  externalMessageId String?   @map("external_message_id")
  provider          String
  templateId        String?   @map("template_id")
  sentAt            DateTime? @default(now()) @map("sent_at") @db.Timestamptz(6)
  payload           Json?
  profile           Profile?  @relation(fields: [profileId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([profileId, kind, sentAt])
  @@index([profileId], map: "email_log_profile_idx")
  @@map("email_log")
}

// ─── rsi_snapshots ───────────────────────────────────────────────────
model RsiSnapshot {
  symbol    String
  interval  String
  rsi       Decimal  @db.Decimal
  price     Decimal? @db.Decimal
  ts        DateTime @db.Timestamptz(6)
  fetchedAt DateTime @default(now()) @map("fetched_at") @db.Timestamptz(6)

  @@id([symbol, interval])
  @@index([interval], map: "rsi_snapshots_interval_idx")
  @@map("rsi_snapshots")
}

// ─── atr_snapshots ──────────────────────────────────────────────────
model AtrSnapshot {
  symbol        String
  atr           Decimal  @db.Decimal
  price         Decimal? @db.Decimal
  dailyOpen     Decimal  @map("daily_open") @db.Decimal
  dailyHigh     Decimal  @map("daily_high") @db.Decimal
  dailyLow      Decimal  @map("daily_low") @db.Decimal
  dailyClose    Decimal  @map("daily_close") @db.Decimal
  upperLevel    Decimal  @map("upper_level") @db.Decimal
  lowerLevel    Decimal  @map("lower_level") @db.Decimal
  exhaustionPct Decimal  @map("exhaustion_pct") @db.Decimal
  direction     String
  ts            DateTime @db.Timestamptz(6)
  fetchedAt     DateTime @default(now()) @map("fetched_at") @db.Timestamptz(6)

  @@id([symbol])
  @@map("atr_snapshots")
}

// ─── channel_threads ─────────────────────────────────────────────────
model ChannelThread {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String
  slug        String        @unique
  description String?
  sortOrder   Int           @default(0) @map("sort_order")
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  posts       ChannelPost[]

  @@index([sortOrder])
  @@map("channel_threads")
}

// ─── channel_posts ───────────────────────────────────────────────────
model ChannelPost {
  id        String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  author    String          @default("Anthony")
  body      String
  imageUrl  String?         @map("image_url")
  tags      String[]        @default([])
  pinned    Boolean         @default(false)
  published Boolean         @default(true)
  threadId  String?         @map("thread_id") @db.Uuid
  thread    ChannelThread?  @relation(fields: [threadId], references: [id])
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([createdAt(sort: Desc)])
  @@index([tags], type: Gin)
  @@index([threadId])
  @@map("channel_posts")
}

model ReferralPartner {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  category  String
  tagline   String   @default("")
  url       String
  iconUrl   String?  @map("icon_url")
  sortOrder Int      @default(0) @map("sort_order")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("referral_partners")
}

// ─── polymarket_tracked ──────────────────────────────────────────────
model PolymarketTracked {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  category    String
  label       String
  eventId     String   @map("event_id")
  eventSlug   String   @map("event_slug")
  eventTitle  String   @map("event_title")
  searchQuery String   @map("search_query")
  active      Boolean  @default(true)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  snapshots PolymarketSnapshot[]

  @@unique([eventId])
  @@index([active, sortOrder])
  @@map("polymarket_tracked")
}

// ─── polymarket_snapshots ────────────────────────────────────────────
model PolymarketSnapshot {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  trackedId   String   @map("tracked_id") @db.Uuid
  outcomes    Json     @default("[]")
  volume      Decimal? @db.Decimal
  liquidity   Decimal? @db.Decimal
  marketCount Int      @default(0) @map("market_count")
  fetchedAt   DateTime @default(now()) @map("fetched_at") @db.Timestamptz(6)

  tracked PolymarketTracked @relation(fields: [trackedId], references: [id], onDelete: Cascade)

  @@index([trackedId, fetchedAt(sort: Desc)])
  @@map("polymarket_snapshots")
}

// ─── gap_snapshots ──────────────────────────────────────────────────
model GapSnapshot {
  symbol       String
  fridayClose  Decimal  @map("friday_close") @db.Decimal
  mondayOpen   Decimal  @map("monday_open") @db.Decimal
  currentPrice Decimal? @map("current_price") @db.Decimal
  gapPct       Decimal  @map("gap_pct") @db.Decimal
  gapDirection String   @map("gap_direction")
  fillPct      Decimal  @default(0) @map("fill_pct") @db.Decimal
  status       String   @default("active")
  weekStart    DateTime @map("week_start") @db.Date
  ts           DateTime @db.Timestamptz(6)
  fetchedAt    DateTime @default(now()) @map("fetched_at") @db.Timestamptz(6)

  @@id([symbol, weekStart])
  @@map("gap_snapshots")
}

model TokenUnlock {
  geckoId    String   @map("gecko_id")
  unlockAt   DateTime @map("unlock_at") @db.Timestamptz(6)
  symbol     String
  name       String
  mcapRank   Int      @map("mcap_rank")
  tokens     Decimal  @db.Decimal
  pctSupply  Decimal  @map("pct_supply") @db.Decimal
  usdValue   Decimal  @map("usd_value") @db.Decimal
  price      Decimal  @db.Decimal
  circSupply Decimal  @map("circ_supply") @db.Decimal
  categories String[] @default([])
  recipients Json     @default("[]")
  fetchedAt  DateTime @default(now()) @map("fetched_at") @db.Timestamptz(6)

  @@id([geckoId, unlockAt])
  @@index([unlockAt], map: "token_unlocks_unlock_at_idx")
  @@map("token_unlocks")
}

model TokenUnlocksMeta {
  id            Int      @id @default(1)
  trackedTop200 Int      @map("tracked_top200")
  syncedAt      DateTime @map("synced_at") @db.Timestamptz(6)

  @@map("token_unlocks_meta")
}

model UpgradeEvent {
  eventId     BigInt   @id @map("event_id")
  coinGeckoId String?  @map("coin_gecko_id")
  symbol      String
  name        String
  mcapRank    Int      @map("mcap_rank")
  title       String
  category    String
  cmcCategory String   @map("cmc_category")
  impact      String?
  impactScore Decimal? @map("impact_score") @db.Decimal
  dateStart   DateTime @map("date_start") @db.Timestamptz(6)
  dateApprox  Boolean  @default(false) @map("date_approx")
  displayDate String   @map("display_date")
  source      String
  coinIcon    String?  @map("coin_icon")
  fetchedAt   DateTime @default(now()) @map("fetched_at") @db.Timestamptz(6)

  @@index([dateStart], map: "upgrade_events_date_start_idx")
  @@map("upgrade_events")
}

model UpgradeEventsMeta {
  id            Int      @id @default(1)
  trackedTop200 Int      @map("tracked_top200")
  syncedAt      DateTime @map("synced_at") @db.Timestamptz(6)

  @@map("upgrade_events_meta")
}
