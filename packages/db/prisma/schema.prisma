generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── profiles ────────────────────────────────────────────────────────
model Profile {
  id               String    @id @db.Uuid
  handle           String?   @unique
  email            String?
  tier             String    @default("free")
  isAdmin          Boolean   @default(false) @map("is_admin")
  signedLiability  Boolean   @default(false) @map("signed_liability")
  joinedAt         DateTime  @default(now()) @map("joined_at") @db.Timestamptz(6)
  renewsAt         DateTime? @map("renews_at") @db.Timestamptz(6)
  package          String?
  tradingLength    String?   @map("trading_length")
  longestProfitable String?  @map("longest_profitable")
  markets          String[]
  yearlyGoal       String?   @map("yearly_goal")
  faultAttribution String?   @map("fault_attribution")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  reviewedNews     NewsItem[]       @relation("NewsReviewer")
  tradingPlans     TradingPlan[]
  consultSessions  ConsultSession[]
  consultMessages  ConsultMessage[]
  telegramAdmins   TelegramAdmin[]
  timelineEvents   TimelineEvent[]  @relation("TimelineCreator")
  emailLogs        EmailLog[]
  payments         Payment[]

  @@map("profiles")
}

// ─── sources ─────────────────────────────────────────────────────────
model Source {
  code          String    @id
  name          String
  url           String
  adapter       String
  enabled       Boolean   @default(true)
  pollMinutes   Int       @default(60) @map("poll_minutes")
  lastPolledAt  DateTime? @map("last_polled_at") @db.Timestamptz(6)
  lastSuccessAt DateTime? @map("last_success_at") @db.Timestamptz(6)
  lastError     String?   @map("last_error")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  newsItems      NewsItem[]
  ingestionRuns  IngestionRun[]

  @@map("sources")
}

// ─── news_items ──────────────────────────────────────────────────────
model NewsItem {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceCode      String    @map("source_code")
  sourceUrl       String?   @map("source_url")
  contentHash     String    @map("content_hash")
  fetchedAt       DateTime  @default(now()) @map("fetched_at") @db.Timestamptz(6)
  rawText         String?   @map("raw_text")
  headline        String
  rephrased       String?
  analysis        String
  impact          String
  bias            String
  affects         String[]  @default([])
  tags            String[]  @default([])
  relatedPlanIds  String[]  @default([]) @map("related_plan_ids")
  author          String
  status          String    @default("pending")
  reviewedBy      String?   @map("reviewed_by") @db.Uuid
  reviewedAt      DateTime? @map("reviewed_at") @db.Timestamptz(6)
  publishedAt     DateTime? @map("published_at") @db.Timestamptz(6)
  aiSystemPrompt  String?   @map("ai_system_prompt")
  aiUserMessage   String?   @map("ai_user_message")
  aiRawResponse   String?   @map("ai_raw_response")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  source          Source    @relation(fields: [sourceCode], references: [code], onUpdate: Cascade)
  reviewer        Profile?  @relation("NewsReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)
  timelineEvents  TimelineEvent[]

  @@unique([sourceCode, contentHash])
  @@index([status])
  @@index([publishedAt(sort: Desc)])
  @@index([sourceCode])
  @@index([tags], type: Gin)
  @@index([affects], type: Gin)
  @@map("news_items")
}

// ─── telegram_admins ─────────────────────────────────────────────────
model TelegramAdmin {
  tgUserId   BigInt    @id @map("tg_user_id")
  profileId  String?   @map("profile_id") @db.Uuid
  label      String?
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  profile    Profile?  @relation(fields: [profileId], references: [id], onDelete: SetNull)

  @@map("telegram_admins")
}

// ─── ingestion_runs ──────────────────────────────────────────────────
model IngestionRun {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceCode     String    @map("source_code")
  startedAt      DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt     DateTime? @map("finished_at") @db.Timestamptz(6)
  status         String    @default("running")
  itemsFetched   Int       @default(0) @map("items_fetched")
  itemsNew       Int       @default(0) @map("items_new")
  itemsRephrased Int       @default(0) @map("items_rephrased")
  error          String?

  source         Source    @relation(fields: [sourceCode], references: [code], onUpdate: Cascade)

  @@index([startedAt(sort: Desc)])
  @@index([sourceCode, startedAt(sort: Desc)])
  @@map("ingestion_runs")
}

// ─── instrument_bars ─────────────────────────────────────────────────
model InstrumentBar {
  symbol   String
  interval String
  ts       DateTime  @db.Timestamptz(6)
  open     Decimal?  @db.Decimal
  high     Decimal?  @db.Decimal
  low      Decimal?  @db.Decimal
  close    Decimal?  @db.Decimal
  volume   Decimal?  @db.Decimal

  @@id([symbol, interval, ts])
  @@map("instrument_bars")
}

// ─── timeline_events ─────────────────────────────────────────────────
model TimelineEvent {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind        String
  sourceCode  String?   @map("source_code")
  occurredAt  DateTime  @map("occurred_at") @db.Timestamptz(6)
  symbols     String[]  @default([])
  title       String
  body        String?
  url         String?
  bias        String?
  impact      String?
  metadata    Json?
  newsItemId  String?   @map("news_item_id") @db.Uuid
  createdBy   String?   @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  newsItem    NewsItem? @relation(fields: [newsItemId], references: [id], onDelete: Cascade)
  creator     Profile?  @relation("TimelineCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([symbols], type: Gin)
  @@index([occurredAt(sort: Desc)])
  @@index([newsItemId])
  @@map("timeline_events")
}

// ─── trading_plans ───────────────────────────────────────────────────
model TradingPlan {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  symbol      String
  thesis      String
  direction   String
  entry       Decimal?  @db.Decimal
  stop        Decimal?  @db.Decimal
  target      Decimal?  @db.Decimal
  rMultiple   Decimal?  @map("r_multiple") @db.Decimal
  setups      Json      @default("[]")
  tags        String[]  @default([])
  tier        String    @default("free")
  status      String    @default("draft")
  outcome     String?
  authorId    String?   @map("author_id") @db.Uuid
  closePrice  Decimal?  @map("close_price") @db.Decimal
  realizedR   Decimal?  @map("realized_r") @db.Decimal
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)
  closedAt    DateTime? @map("closed_at") @db.Timestamptz(6)

  author      Profile?  @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([publishedAt(sort: Desc)])
  @@index([symbol])
  @@index([authorId])
  @@index([tags], type: Gin)
  @@map("trading_plans")
}

// ─── consult_sessions ────────────────────────────────────────────────
model ConsultSession {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  title     String    @default("New session")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user      Profile   @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  ConsultMessage[]

  @@index([userId, updatedAt(sort: Desc)])
  @@map("consult_sessions")
}

// ─── consult_messages ────────────────────────────────────────────────
model ConsultMessage {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId String   @map("session_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      String
  content   String
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  session   ConsultSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user      Profile        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt(sort: Asc)])
  @@index([userId])
  @@map("consult_messages")
}

// ─── education_primers ───────────────────────────────────────────────
model EducationPrimer {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug       String    @unique
  title      String
  author     String    @default("Anthony")
  framework  String?
  summary    String?
  body       String[]  @default([])
  tags       String[]  @default([])
  readingMin Int       @default(3) @map("reading_min")
  locked     Boolean   @default(false)
  published  Boolean   @default(true)
  sortOrder  Int       @default(0) @map("sort_order")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([published, sortOrder])
  @@index([tags], type: Gin)
  @@map("education_primers")
}

// ─── payments ────────────────────────────────────────────────────────
model Payment {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId    String    @map("profile_id") @db.Uuid
  externalId   String?   @map("external_id")
  externalRef  String    @unique @map("external_ref")
  provider     String
  amount       Decimal   @db.Decimal
  currency     String    @default("IDR")
  status       String    @default("pending")
  tier         String
  invoiceUrl   String?   @map("invoice_url")
  description  String?
  paidAt       DateTime? @map("paid_at") @db.Timestamptz(6)
  expiredAt    DateTime? @map("expired_at") @db.Timestamptz(6)
  metadata     Json?
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  profile      Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, createdAt(sort: Desc)])
  @@index([status])
  @@index([externalId])
  @@map("payments")
}

// ─── email_log ───────────────────────────────────────────────────────
model EmailLog {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId         String?   @map("profile_id") @db.Uuid
  kind              String
  externalMessageId String?   @map("external_message_id")
  provider          String
  templateId        String?   @map("template_id")
  sentAt            DateTime? @default(now()) @map("sent_at") @db.Timestamptz(6)
  payload           Json?

  profile           Profile?  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, kind, sentAt])
  @@index([profileId])
  @@map("email_log")
}
