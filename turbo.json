{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local", "**/.env"],
  "globalEnv": [
    "NODE_ENV",
    "LOG_LEVEL",
    "NEXT_PUBLIC_SUPABASE_URL",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY",
    "SUPABASE_URL",
    "SUPABASE_SERVICE_ROLE_KEY",
    "OPENAI_API_KEY",
    "OPENAI_MODEL",
    "TELEGRAM_BOT_TOKEN",
    "TELEGRAM_ADMIN_CHAT_IDS",
    "FRED_API_KEY",
    "ENABLED_SOURCES",
    "NEXT_PUBLIC_SITE_URL",
    "SITE_URL",
    "HEARTBEAT_URL",
    "HEARTBEAT_INTERVAL_MIN",
    "MARKET_DATA_PROVIDER",
    "MARKET_DATA_API_KEY",
    "UPSTASH_REDIS_REST_URL",
    "UPSTASH_REDIS_REST_TOKEN",
    "XENDIT_SECRET_KEY",
    "XENDIT_WEBHOOK_TOKEN",
    "EMAIL_PROVIDER",
    "BREVO_API_KEY",
    "EMAIL_SENDER_EMAIL",
    "EMAIL_SENDER_NAME",
    "RENEWAL_TEMPLATE_ID",
    "DUNNING_TEMPLATE_ID",
    "LOGTAIL_SOURCE_TOKEN",
    "LOGTAIL_ENDPOINT"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  }
}
