# Required
API_PORT=3100

# JWT secret for signing & verifying auth tokens (generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))")
JWT_SECRET=

# Prisma — Postgres connection string
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Supabase (optional — only if web app uses Supabase Auth)
# SUPABASE_URL=https://xxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=

# Site URL — used for email verification links
SITE_URL=http://localhost:3000

# CORS — comma-separated origins
CORS_ORIGIN=http://localhost:3199

# Optional — graceful degradation when unset
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Payment (optional — Xendit)
PAYMENT_PROVIDER=xendit
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=

# Email (optional — uses built-in HTML templates, no template IDs needed)
EMAIL_PROVIDER=brevo
BREVO_API_KEY=
EMAIL_SENDER_EMAIL=
EMAIL_SENDER_NAME=

# File storage (optional — consult image uploads)
# Provider: "supabase" or "s3"
STORAGE_PROVIDER=supabase
STORAGE_BUCKET=uploads
# Supabase storage uses SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY above.
# S3/R2 storage uses:
# AWS_S3_BUCKET=
# AWS_S3_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_ENDPOINT=

# Observability (optional)
SENTRY_DSN=
LOG_LEVEL=info
