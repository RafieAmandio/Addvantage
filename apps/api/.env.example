# Required
API_PORT=3100
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Prisma — Supabase Postgres connection string (transaction pooler, port 6543)
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# CORS — comma-separated origins
CORS_ORIGIN=http://localhost:3199

# Optional — graceful degradation when unset
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Payment (optional)
PAYMENT_PROVIDER=xendit
XENDIT_WEBHOOK_TOKEN=

# Email (optional)
EMAIL_PROVIDER=brevo
BREVO_API_KEY=
EMAIL_SENDER_EMAIL=
EMAIL_SENDER_NAME=

# S3 / R2 file uploads (optional — consult image upload)
AWS_S3_BUCKET=
AWS_S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Custom endpoint for R2/MinIO (optional)
AWS_S3_ENDPOINT=

# Dunning email template (optional)
DUNNING_TEMPLATE_ID=

# Observability (optional)
SENTRY_DSN=
LOG_LEVEL=info
