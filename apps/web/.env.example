# Public — shipped to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://qawrdgttfpslyelocfmx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Demo mode — set to 1 to run the frontend off static fixtures instead of
# Supabase. Auth is bypassed; /app/news, /app/plan, /app/watchlist,
# /app/calendar all work end-to-end with no keys required. Other pages fall
# back to empty states. Useful for showing the UI to teammates.
# NEXT_PUBLIC_MOCK_MODE=1

# Express API URL (defaults to http://localhost:3100 if unset)
NEXT_PUBLIC_API_URL=http://localhost:3100

# Server-only. Never prefix with NEXT_PUBLIC_.
# JWT secret — must match the API's JWT_SECRET for token verification
JWT_SECRET=

# Supabase (only needed if using Supabase storage)
SUPABASE_SERVICE_ROLE_KEY=

# Upstash Redis (optional — rate limiting. Unset = no rate limits)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# --- Sentry error tracking ---
# Server/edge DSN. Unset = graceful no-op (no init).
# SENTRY_DSN=
# Client DSN (shipped in the browser bundle). Unset = graceful no-op.
# NEXT_PUBLIC_SENTRY_DSN=
