NODE_ENV=development
LOG_LEVEL=info

# Supabase — server credentials only, never ship to web clients.
SUPABASE_URL=https://qawrdgttfpslyelocfmx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Telegram
TELEGRAM_BOT_TOKEN=
# comma-separated chat ids allowed to interact with the bot
TELEGRAM_ADMIN_CHAT_IDS=

# FRED (free key: https://fred.stlouisfed.org/docs/api/api_key.html)
FRED_API_KEY=

# Public web URL used in Telegram deeplinks
SITE_URL=https://tradevantage.gg

# Override adapter selection (empty = use DB sources.enabled)
ENABLED_SOURCES=

# Optional liveness ping. Set to a healthchecks.io / BetterStack heartbeat URL
# (or any endpoint that treats a POST as "I'm alive"). Empty = disabled.
HEARTBEAT_URL=
HEARTBEAT_INTERVAL_MIN=5

# --- Market data ---
# Provider for OHLCV bars (Phase B). Leave both blank until Phase B is wired.
MARKET_DATA_PROVIDER=twelvedata
MARKET_DATA_API_KEY=

# --- Better Stack (Logtail) log ingestion ---
# When set, the worker's pino logger dual-writes to stdout + Better Stack via
# the @logtail/pino transport. Unset = stdout only (default behavior).
# LOGTAIL_SOURCE_TOKEN=
# Optional override for region-specific ingest hosts. Default matches
# @logtail/node (https://in.logs.betterstack.com).
# LOGTAIL_ENDPOINT=
