{
  "name": "@tradevantage/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "run:once": "tsx src/cli/run-once.ts",
    "run:bars": "tsx src/cli/run-bars.ts",
    "clean": "rm -rf dist .turbo tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@logtail/pino": "^0.5.8",
    "@sentry/node": "^10.49.0",
    "@supabase/supabase-js": "^2.45.4",
    "@tradevantage/db": "workspace:*",
    "@tradevantage/shared": "workspace:*",
    "@upstash/redis": "^1.34.3",
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.5",
    "grammy": "^1.30.0",
    "node-cron": "^3.0.3",
    "openai": "^4.67.3",
    "pino": "^9.4.0",
    "undici": "^6.19.8",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/node-cron": "^3.0.11",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.58.2",
    "eslint": "^8.57.0",
    "pino-pretty": "^11.2.2",
    "tsx": "^4.19.1",
    "typescript": "^5.5.3"
  }
}
